; Engine configuration file.
config_version=5

[application]

config/name="Frequência Viva"
config/description="Um puzzle de sintonia e circulação de mensagens."
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.086, 0.122, 0.165, 1)

[audio]

driver/enable_input=false
